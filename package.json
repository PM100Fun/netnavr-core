{
  "name": "@netnavr/core",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/server.js",
    "./contract": {
      "types": "./contracts/core-v1.d.ts",
      "default": "./contracts/core-v1.js"
    },
    "./fixture-contract": {
      "types": "./contracts/fixture-v1.d.ts",
      "default": "./contracts/fixture-v1.js"
    }
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "verify": "npm test && npm run build"
  },
  "license": "Apache-2.0",
  "description": "Local NetNavr identity runtime and versioned Core HTTP contract.",
  "repository": "github:PM100Fun/netnavr-core",
  "files": ["dist/", "contracts/", "LICENSE", "NOTICE"]
}
